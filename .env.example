# ==============================================================================
# BugFlow Backend - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Note: Do not commit .env to version control.
# ==============================================================================

# MongoDB Connection
# Replace with your rotated MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=<cluster-name>
MONGODB_DATABASE=bugflow

# Server Port
PORT=8081

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Auth0 Authentication
AUTH0_DOMAIN=your_auth0_domain.us.auth0.com
AUTH0_AUDIENCE=https://bugflow-api

# JWT Configuration (At least 32 characters / 256 bits)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters
JWT_EXPIRATION=86400000

# SMTP Email Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=your_email@gmail.com

# Frontend URL
FRONTEND_BASE_URL=http://localhost:3000
